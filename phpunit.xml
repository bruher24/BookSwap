<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!--        <testsuite name="Unit">-->
        <!--            <directory>tests/Unit</directory>-->
        <!--        </testsuite>-->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <!-- HTML-отчет в папку coverage -->
            <html outputDirectory="coverage"/>
            <!-- Текстовый вывод в консоль -->
            <text outputFile="php://stdout"/>
            <!-- XML-отчет в формате Clover (для внешних сервисов) -->
            <clover outputFile="coverage/clover.xml"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_KEY" value="base64:x6rcvRdIEceoxij02q8PV9hniZxCKkv7AABDSK5zwyw=" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>

        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>

        <server name="SCOUT_DRIVER" value="collection" force="true"/>
        <server name="SCOUT_QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SCOUT_QUEUE" value="default" force="true"/>

        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>

        <server name="LOG_CHANNEL" value="null" force="true"/>
        <server name="LOG_LEVEL" value="null" force="true"/>
    </php>
</phpunit>
